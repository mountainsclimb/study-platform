{$STUDY_DOMAIN:localhost} {
	encode zstd gzip
	# 反代层请求体硬上限（第一道限额）：单个上传 ≤30MB，工坊批量导入最多 20 个文件、
	# 答题卡扫描最多 10 页。768MB 覆盖合法批量请求并留出 multipart 开销，同时挡住无界请求体；
	# 超限由 Caddy 直接返回 413，不进入应用进程。需要调整时改这里并同步 deploy/README.md。
	# （request_body 需 Caddy ≥ 2.10；Compose 的 caddy:2-alpine 会取当前 2.x 最新版。）
	request_body {
		max_size 768MB
	}
	reverse_proxy app:8765 {
		flush_interval -1
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}
