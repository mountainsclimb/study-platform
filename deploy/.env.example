# 知序 Docker Compose 部署环境样例：复制为 deploy/.env 后按需修改。
# 注意：deploy/.env 已在 .gitignore 中忽略，切勿把真实密码提交进仓库。

# 公网域名（Caddy 自动签发证书）与允许访问的 Host 头
STUDY_DOMAIN=zhixu.example.com
STUDY_ALLOWED_HOSTS=zhixu.example.com,localhost,127.0.0.1

# PostgreSQL 密码（必填；含 URL 保留字符时 DATABASE_URL 里需要百分号编码）
PG_PASSWORD=please-change-me

# Redis 密码：Compose 默认启用 requirepass，Web/Worker 连接串自动带上。
# 含 @ : / ? 等 URL 保留字符时请填百分号编码后的值（例如 p%40ss）。
REDIS_PASSWORD=please-change-me

# 宿主机题库根目录（只读挂载；应用跟随 releases/CURRENT）
HOST_BANK_DIR=../../高考题库_按学科

# 公网模式：1 = 关闭自动注册、强制 Secure Cookie，需先用管理员初始化口令创建管理员
STUDY_PUBLIC_MODE=1
STUDY_REGISTRATION_MODE=
STUDY_ADMIN_INIT_TOKEN=

# 部署探针口令：curl -H "X-Health-Token: <值>" https://<域名>/api/health/ready 可读完整就绪详情
STUDY_HEALTH_TOKEN=

# AI 自定义地址策略：留空随 STUDY_PUBLIC_MODE 自动决策；严格托管可设 allowlist
STUDY_AI_URL_POLICY=
STUDY_AI_ALLOWED_HOSTS=

# 可选的镜像构建号（建议写提交号）
STUDY_BUILD_ID=

# 可选：期望题库版本，不一致时 /api/health/ready 降级
STUDY_EXPECTED_BANK_VERSION=

# 可选：对象存储（S3/MinIO）
S3_BUCKET=
S3_ENDPOINT_URL=
S3_PREFIX=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
