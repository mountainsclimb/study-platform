# 知序 Docker Compose 部署环境样例：复制为 deploy/.env 后按需修改。
# 注意：deploy/.env 已在 .gitignore 中忽略，切勿把真实密码提交进仓库。
#
# 公网部署启用前先运行（应用启动时还会做一次 fail-closed 自检）：
#   python scripts/check_public_config.py --env-file deploy/.env
# 管理员初始化完成后可用 --admin-exists 复核：
#   python scripts/check_public_config.py --env-file deploy/.env --admin-exists

# ---- 公网域名与 Host 校验（必填） ----
# Caddy 自动签发证书：域名需解析到服务器并开放 TCP 80/443。
STUDY_DOMAIN=zhixu.example.com
# 只列实际对外域名；禁止通配符（*）与本地/回环地址。
# 本机调试可临时加 localhost,127.0.0.1，正式部署前必须移除。
STUDY_ALLOWED_HOSTS=zhixu.example.com

# ---- 运行模式（必填：1 = 公网，0 = 本地） ----
# 公网模式：关闭自动注册、首个注册者不再成为管理员、会话 Cookie 强制 Secure，
# 并在启动时校验本文件的公网关键配置。Compose 对空值会直接拒绝启动。
STUDY_PUBLIC_MODE=1
STUDY_REGISTRATION_MODE=

# ---- 反向代理可信来源（必填，禁止 *） ----
# 只信任这些来源发来的 X-Forwarded-*。Caddy 与 app 同在 Compose 默认 bridge 网络时
# 一般是 172.16.0.0/12；自定义网络请按实际网段修改。留空时 Compose 拒绝启动。
FORWARDED_ALLOW_IPS=172.16.0.0/12

# ---- PostgreSQL（必填；公网必须用 PostgreSQL，SQLite 仅本地开发） ----
# 留空会让 Compose 直接拒绝启动；请替换为至少 24 位随机串。
# 含 @ : / ? 等 URL 保留字符时，DATABASE_URL 里需要百分号编码（默认由 PG_PASSWORD 拼接）。
PG_PASSWORD=
# 可选：显式连接串；留空时 Compose 用 PG_PASSWORD 自动拼接。
DATABASE_URL=

# ---- Redis（必填；AI 任务队列/Worker 需要） ----
# 留空会让 Compose 直接拒绝启动；请替换为至少 24 位随机串（禁止 changeme 等示例值）。
# 含 @ : / ? 等 URL 保留字符时请填百分号编码后的值（例如 p%40ss）。
# Compose 会用该变量启动 requirepass 并自动拼接 REDIS_URL；如需 rediss:// 或 Redis 6+ ACL，
# 请按 README 修改 docker-compose.yml 中的 REDIS_URL。独立部署（不用 Compose）时直接设置 REDIS_URL。
REDIS_PASSWORD=

# ---- 管理员初始化（首次公网部署必填；初始化成功后移除） ----
# 至少 8 位随机串，仅运营持有；对应 POST /api/auth/init-admin 的一次性口令。
# 生成示例：python -c "import secrets;print(secrets.token_urlsafe(32))"
STUDY_ADMIN_INIT_TOKEN=

# ---- 部署探针（建议配置） ----
# curl -H "X-Health-Token: <值>" https://<域名>/api/health/ready 可读完整就绪详情。
STUDY_HEALTH_TOKEN=

# ---- 题库挂载 ----
# 宿主机题库根目录（只读挂载；应用跟随 releases/CURRENT）。
HOST_BANK_DIR=../../高考题库_按学科

# ---- AI 出站地址策略（公网保持 public_https 或 allowlist） ----
# public_https：仅允许公网 HTTPS；allowlist：再用域名白名单收紧，普通账号不能修改白名单。
# 公网模式禁止 local_open。留空时按运行模式自动决策（公网 = public_https）。
STUDY_AI_URL_POLICY=public_https
STUDY_AI_ALLOWED_HOSTS=

# ---- 可选 ----
STUDY_BUILD_ID=
# 期望题库版本，不一致时 /api/health/ready 降级。
STUDY_EXPECTED_BANK_VERSION=
# 对象存储（S3/MinIO）；启用时 Web 与 Worker 使用同一桶，先创建桶。
S3_BUCKET=
S3_ENDPOINT_URL=
S3_PREFIX=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
