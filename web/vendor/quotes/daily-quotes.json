[{"id":1,"q":"关山魂梦长，塞雁音书少。","a":"王观","t":"生查子","s":"宋词三百首"},{"id":2,"q":"一派秋声入寥廓。","a":"王安石","t":"千秋岁引","s":"宋词三百首"},{"id":3,"q":"鞉鼓渊渊，嘒嘒管声。既和且平，依我磬声。于赫汤孙！穆穆厥声。","a":"佚名","t":"那","s":"诗经"},{"id":4,"q":"伤心故人去後，冷落新诗。","a":"李邴","t":"汉宫春","s":"宋词三百首"},{"id":5,"q":"最是一年春好处，绝胜烟柳满皇都。","a":"韩愈","t":"早春","s":"水墨唐诗"},{"id":6,"q":"式遏寇虐，无俾作慝。敬慎威仪，以近有德。","a":"佚名","t":"民劳","s":"诗经"},{"id":7,"q":"上好信，则民莫敢不用情。","a":"孔子","t":"子路篇","s":"论语"},{"id":8,"q":"如其礼乐，以俟君子。","a":"孔子","t":"先进篇","s":"论语"},{"id":9,"q":"陪臣执国命，三世希不失矣。","a":"孔子","t":"季氏篇","s":"论语"},{"id":10,"q":"不见又思量，见了还依旧。","a":"李之仪","t":"谢池春","s":"宋词三百首"},{"id":11,"q":"孑孑干旌，在浚之城。素丝祝之，良马六之。彼姝者子，何以告之？","a":"佚名","t":"干旄","s":"诗经"},{"id":12,"q":"能诗者必好酒，而好酒者未必尽属能诗。","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":13,"q":"其身不正，虽令不从。","a":"孔子","t":"子路篇","s":"论语"},{"id":14,"q":"那堪正漂泊，明日岁华新。","a":"崔涂","t":"除夜有怀","s":"水墨唐诗"},{"id":15,"q":"以吾从大夫之后，不可徒行也。","a":"孔子","t":"先进篇","s":"论语"},{"id":16,"q":"君子忧道不忧贫。","a":"孔子","t":"卫灵公篇","s":"论语"},{"id":17,"q":"娶妇贤淑，生子聪慧。","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":18,"q":"猿鸟犹疑畏简书，风云长为护储胥。","a":"李商隐","t":"筹笔驿","s":"水墨唐诗"},{"id":19,"q":"葛之覃兮，施于中谷，维叶莫莫。是刈是濩，为絺为绤，服之无斁。","a":"佚名","t":"葛覃","s":"诗经"},{"id":20,"q":"言念君子，载寝载兴。厌厌良人，秩秩德音。","a":"佚名","t":"小戎","s":"诗经"},{"id":21,"q":"楼上黄昏，片帆千里归程，年华将晚。","a":"蔡伸","t":"苏武慢","s":"宋词三百首"},{"id":22,"q":"酒市渐闲灯火，正敲窗、乱叶舞纷纷。","a":"孔夷","t":"南浦","s":"宋词三百首"},{"id":23,"q":"想佩环、月夜归来，化作此花幽独。","a":"姜夔","t":"疏影","s":"宋词三百首"},{"id":24,"q":"君子之车，既庶且多。君子之马，既闲且驰。矢诗不多，维以遂歌。","a":"佚名","t":"卷阿","s":"诗经"},{"id":25,"q":"齐人归女乐，季桓子受之，三日不朝，孔子行。","a":"孔子","t":"微子篇","s":"论语"},{"id":26,"q":"孟氏使阳肤为士师，问于曾子。","a":"孔子","t":"子张篇","s":"论语"},{"id":27,"q":"摽有梅，其实七兮。求我庶士，迨其吉兮。","a":"佚名","t":"摽有梅","s":"诗经"},{"id":28,"q":"北阙休上书，南山归敝庐。","a":"孟浩然","t":"岁暮归南山","s":"水墨唐诗"},{"id":29,"q":"炼精化气，炼气化神，清虚有何渣滓！","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":30,"q":"野寺荒台晚，寒天古木悲。","a":"岑参","t":"题三会寺仓颉造字台","s":"水墨唐诗"},{"id":31,"q":"一寸还成千万缕。","a":"晏殊","t":"玉楼春","s":"宋词三百首"},{"id":32,"q":"报道山中去，归时每日斜。","a":"皎然","t":"寻陆鸿渐不遇","s":"水墨唐诗"},{"id":33,"q":"长门事，准拟佳期又误。","a":"辛弃疾","t":"摸鱼儿","s":"宋词三百首"},{"id":34,"q":"牛与马，一仕而一隐也；","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":35,"q":"曲可以当词，词不可以当曲；","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":36,"q":"君薨，百官总己以听于冢宰三年。","a":"孔子","t":"宪问篇","s":"论语"},{"id":37,"q":"狮子、牯牛之属，近于释者也。","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":38,"q":"红颜者必薄命，而薄命者未必尽属红颜；","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":39,"q":"尔爱其羊，我爱其礼。","a":"孔子","t":"八佾篇","s":"论语"},{"id":40,"q":"文献不足故也，足则吾能征之矣。","a":"孔子","t":"八佾篇","s":"论语"},{"id":41,"q":"对滑稽友，如阅传奇小说。","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":42,"q":"凭栏久，黄芦苦竹，拟泛九江船。","a":"周邦彦","t":"满庭芳","s":"宋词三百首"},{"id":43,"q":"停车坐爱枫林晚，霜叶红于二月花。","a":"杜牧","t":"山行","s":"水墨唐诗"},{"id":44,"q":"卖炭翁，伐薪烧炭南山中。","a":"白居易","t":"卖炭翁","s":"水墨唐诗"},{"id":45,"q":"嗟嗟烈祖！有秩斯祜。申锡无疆，及尔斯所。既载清酤，赉我思成。","a":"佚名","t":"烈祖","s":"诗经"},{"id":46,"q":"瀚海阑干百丈冰，愁云惨淡万里凝。","a":"岑参","t":"白雪歌送武判官归京","s":"水墨唐诗"},{"id":47,"q":"流落征南将，曾驱十万师。","a":"刘长卿","t":"送李中丞归汉阳别业","s":"水墨唐诗"},{"id":48,"q":"静夜四无邻，荒居旧业贫。","a":"司空曙","t":"喜外弟卢纶见宿","s":"水墨唐诗"},{"id":49,"q":"养花胆瓶，其式之高低大小，须与花相称；","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":50,"q":"一日之计种蕉，一岁之计种竹，十年之计种柳，百年之计种松。","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":51,"q":"蓼蓼者莪，匪莪伊蔚。哀哀父母，生我劳瘁。","a":"佚名","t":"蓼莪","s":"诗经"},{"id":52,"q":"自销凝，能几花前，顿老相如。","a":"吴文英","t":"高阳台","s":"宋词三百首"},{"id":53,"q":"能闲世人之所忙者，方能忙世人之所闲。","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":54,"q":"不应有恨，何事长向别时圆。","a":"苏轼","t":"水调歌头","s":"宋词三百首"},{"id":55,"q":"花与叶俱不足观者，紫薇也，辛夷也。","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":56,"q":"嗟尔君子，无恒安息。靖共尔位，好是正直。神之听之，介尔景福。","a":"佚名","t":"小明","s":"诗经"},{"id":57,"q":"当义熙之世，曾一醉渊明否？","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":58,"q":"辜负枕前云雨，尊前花月。","a":"张元干","t":"石州慢","s":"宋词三百首"},{"id":59,"q":"帝命不违，至于汤齐。汤降不迟，圣敬日跻。昭假迟迟，上帝是祗，帝命式于九围。","a":"佚名","t":"长发","s":"诗经"},{"id":60,"q":"子欲善而民善矣。","a":"孔子","t":"颜渊篇","s":"论语"},{"id":61,"q":"游历之山水，不必过求其妙；","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":62,"q":"与朋友交而不信乎？","a":"孔子","t":"学而篇","s":"论语"},{"id":63,"q":"试问夜如何，夜已三更，金波淡、玉绳低转。","a":"苏轼","t":"洞仙歌","s":"宋词三百首"},{"id":64,"q":"祭如在，祭神如神在。","a":"孔子","t":"八佾篇","s":"论语"},{"id":65,"q":"穀旦于逝，越以鬷迈。视尔如荍，贻我握椒。","a":"佚名","t":"东门之枌","s":"诗经"},{"id":66,"q":"吾家公艺，恃百忍以同居，千古传为美谈。","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":67,"q":"淮左名都，竹西佳处，解鞍少驻初程。","a":"姜夔","t":"扬州慢","s":"宋词三百首"},{"id":68,"q":"旅馆无良伴，凝情自悄然。","a":"杜牧","t":"旅宿","s":"水墨唐诗"},{"id":69,"q":"为伊消得人憔悴。","a":"柳永","t":"凤栖梧・蝶恋花","s":"宋词三百首"},{"id":70,"q":"九曲黄河万里沙，浪淘风簸自天涯。","a":"刘禹锡","t":"浪淘沙","s":"水墨唐诗"},{"id":71,"q":"春雨如恩诏，夏雨如赦书，秋雨如挽歌。","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":72,"q":"不能以礼让为国，如礼何？","a":"孔子","t":"里仁篇","s":"论语"},{"id":73,"q":"记取楼前绿水，应念我、终日凝眸。","a":"李清照","t":"凤凰台上忆吹箫","s":"宋词三百首"},{"id":74,"q":"杜甫天才颇绝伦，每寻诗卷似情亲。","a":"元稹","t":"酬李甫见赠","s":"水墨唐诗"},{"id":75,"q":"乘其四骐，四骐翼翼。路车有奭，簟茀鱼服，钩膺鞗革。","a":"佚名","t":"采芑","s":"诗经"},{"id":76,"q":"移舟泊烟渚，日暮客愁新。","a":"孟浩然","t":"宿建德江","s":"水墨唐诗"},{"id":77,"q":"不记归时早暮，上马谁扶，醒眠朱阁。","a":"周邦彦","t":"瑞鹤仙","s":"宋词三百首"},{"id":78,"q":"熏炉畔、旋移傍枕，还又见、玉人垂绀鬒。","a":"吴文英","t":"花犯","s":"宋词三百首"},{"id":79,"q":"武将论文章，半属道听途说。","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":80,"q":"盖姓实有佳有劣，如华、如柳、如云、如苏、如乔，皆极风韵；","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":81,"q":"秩秩斯干，幽幽南山。如竹苞矣，如松茂矣。兄及弟矣，式相好矣，无相犹矣。","a":"佚名","t":"斯干","s":"诗经"},{"id":82,"q":"君子敬而无失，与人恭而有礼，四海之内皆兄弟也。","a":"孔子","t":"颜渊篇","s":"论语"},{"id":83,"q":"一睹其貌，则美恶判然矣。","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":84,"q":"死而后已，不亦远乎？","a":"孔子","t":"泰伯篇","s":"论语"},{"id":85,"q":"巧沁兰心，偷黏草甲，东风欲障新暖。","a":"史达祖","t":"东风第一枝","s":"宋词三百首"},{"id":86,"q":"子不语怪、力、乱、神。","a":"孔子","t":"述而篇","s":"论语"},{"id":87,"q":"把似而今醒到了，料当年、醉死差无苦。","a":"刘克庄","t":"贺新郎","s":"宋词三百首"},{"id":88,"q":"或燕燕居息，或尽瘁事国；或息偃在床，或不已于行。","a":"佚名","t":"北山","s":"诗经"},{"id":89,"q":"齐必变食，居必迁坐。","a":"孔子","t":"乡党篇","s":"论语"},{"id":90,"q":"望不尽、楼台歌舞，习习香尘莲步底。","a":"刘辰翁","t":"宝鼎现","s":"宋词三百首"},{"id":91,"q":"夏之茗，冬之姜汤，复可以济役夫负戴之困，三也。","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":92,"q":"夫君子之居丧，食旨不甘，闻乐不乐，居处不安，故不为也。","a":"孔子","t":"阳货篇","s":"论语"},{"id":93,"q":"得其门者或寡矣，夫子之云不亦宜乎！","a":"孔子","t":"子张篇","s":"论语"},{"id":94,"q":"友便辟、友善柔、有便佞，损矣。","a":"孔子","t":"季氏篇","s":"论语"},{"id":95,"q":"冰肌玉骨，自清凉无汗。","a":"苏轼","t":"洞仙歌","s":"宋词三百首"},{"id":96,"q":"嫦娥应悔偷灵药，碧海青天夜夜心。","a":"李商隐","t":"嫦娥","s":"水墨唐诗"},{"id":97,"q":"告子以甘食、悦色为性，殆指此类耳。","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":98,"q":"蓼彼萧斯，零露泥泥。既见君子，孔燕岂弟。宜兄宜弟，令德寿岂。","a":"佚名","t":"蓼萧","s":"诗经"},{"id":99,"q":"天下唯鬼最富，生前囊无一文，死后每饶楮镪；","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":100,"q":"仲氏任只，其心塞渊。终温且惠，淑慎其身。先君之思，以勖寡人。","a":"佚名","t":"燕燕","s":"诗经"},{"id":101,"q":"若施之缣素，则不可不求其佳。","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":102,"q":"先天八卦，竖看者也；","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":103,"q":"有朋自远方来，不亦乐乎？","a":"孔子","t":"学而篇","s":"论语"},{"id":104,"q":"天之将丧斯文也，后死者不得与于斯文也；","a":"孔子","t":"子罕篇","s":"论语"},{"id":105,"q":"平明寻白羽，没在石棱中。","a":"卢纶","t":"塞下曲","s":"水墨唐诗"},{"id":106,"q":"乐云乐云，钟鼓云乎哉？","a":"孔子","t":"阳货篇","s":"论语"},{"id":107,"q":"仁者安仁，知者利仁。","a":"孔子","t":"里仁篇","s":"论语"},{"id":108,"q":"饮酒孔嘉，维其令仪。","a":"佚名","t":"宾之初筵","s":"诗经"},{"id":109,"q":"貌有丑而可观者，有虽不丑而不足观者；","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":110,"q":"一道残阳铺水中，半江瑟瑟半江红。","a":"白居易","t":"暮江吟","s":"水墨唐诗"},{"id":111,"q":"黄鸟黄鸟，无集于栩，无啄我黍。此邦之人，不可与处。言旋言归，复我诸父。","a":"佚名","t":"黄鸟","s":"诗经"},{"id":112,"q":"山围故国周遭在，潮打空城寂寞回。","a":"刘禹锡","t":"石头城","s":"水墨唐诗"},{"id":113,"q":"周有八士：伯达、伯适、仲突、仲忽、叔夜、叔夏、季随、季騧。","a":"孔子","t":"微子篇","s":"论语"},{"id":114,"q":"可与适道，未可与立；","a":"孔子","t":"子罕篇","s":"论语"},{"id":115,"q":"洗妆真态，不作铅华御。","a":"曹组","t":"蓦山溪","s":"宋词三百首"},{"id":116,"q":"吉月，必朝服而朝。","a":"孔子","t":"乡党篇","s":"论语"},{"id":117,"q":"是当初、谁敢疏狂。","a":"史达祖","t":"夜合花","s":"宋词三百首"},{"id":118,"q":"故人江海别，几度隔山川。","a":"司空曙","t":"云阳馆与韩绅宿别","s":"水墨唐诗"},{"id":119,"q":"谁知错管春残事。","a":"晏几道","t":"玉楼春","s":"宋词三百首"},{"id":120,"q":"以忧生，不若以乐死。","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":121,"q":"草色烟光残照里。","a":"柳永","t":"凤栖梧・蝶恋花","s":"宋词三百首"},{"id":122,"q":"花隐掖垣暮，啾啾栖鸟过。","a":"杜甫","t":"春宿左省","s":"水墨唐诗"},{"id":123,"q":"何意重红满地，遗钿不见，斜径都迷。","a":"周邦彦","t":"夜飞鹊・夜飞鹊慢","s":"宋词三百首"},{"id":124,"q":"善读书者，无之而非书：山水亦书也，棋酒亦书也，花月亦书也；","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":125,"q":"六月食郁及薁，七月亨葵及菽。八月剥枣，十月获稻。为此春酒，以介眉寿。","a":"佚名","t":"七月","s":"诗经"},{"id":126,"q":"蝴蝶梦为庄周，蝴蝶之不幸也。","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":127,"q":"诞降嘉种，维秬维秠，维穈维芑。恒之秬秠，是获是亩。","a":"佚名","t":"生民","s":"诗经"},{"id":128,"q":"多见阙殆，慎行其余，则寡悔。","a":"孔子","t":"为政篇","s":"论语"},{"id":129,"q":"月可以当灯，灯不可以当月；","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":130,"q":"算重来、尽成陈迹。","a":"晁补之","t":"忆少年","s":"宋词三百首"},{"id":131,"q":"胸中小不平，可以酒消之；","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":132,"q":"无情画舸，都不管、烟波隔南浦。","a":"周邦彦","t":"尉迟杯","s":"宋词三百首"},{"id":133,"q":"择其善者而从之，其不善者而改之。","a":"孔子","t":"述而篇","s":"论语"},{"id":134,"q":"便只恐、瓶沈金井。","a":"潘汾","t":"贺新郎","s":"宋词三百首"},{"id":135,"q":"长恨此身非我有，何时忘却营营。","a":"苏轼","t":"临江仙","s":"宋词三百首"},{"id":136,"q":"茫茫江汉上，日暮欲何之。","a":"刘长卿","t":"送李中丞归汉阳别业","s":"水墨唐诗"},{"id":137,"q":"此去经年，应是良辰、好景虚设。","a":"柳永","t":"雨霖铃","s":"宋词三百首"},{"id":138,"q":"中年读书，如庭中望月；","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":139,"q":"记取崔徽模样，归来暗写。","a":"史达祖","t":"三姝媚","s":"宋词三百首"},{"id":140,"q":"伊嘏文王，既右飨之。我其夙夜，畏天之威，于时保之。","a":"佚名","t":"我将","s":"诗经"},{"id":141,"q":"千古江山，英雄无觅，孙仲谋处。","a":"辛弃疾","t":"永遇乐","s":"宋词三百首"},{"id":142,"q":"妾美不如妻贤，钱多不如境顺。","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":143,"q":"楚江微雨里，建业暮钟时。","a":"韦应物","t":"赋得暮雨送李曹","s":"水墨唐诗"},{"id":144,"q":"左之左之，君子宜之。右之右之，君子有之。维其有之，是以似之。","a":"佚名","t":"裳裳者华","s":"诗经"},{"id":145,"q":"或乞醯焉，乞诸其邻而与之。","a":"孔子","t":"公冶长篇","s":"论语"},{"id":146,"q":"式遏寇虐，无俾正败。戎虽小子，而式弘大。","a":"佚名","t":"民劳","s":"诗经"},{"id":147,"q":"言寡尤，行寡悔，禄在其中矣。","a":"孔子","t":"为政篇","s":"论语"},{"id":148,"q":"嗟万事难忘，唯是轻别。","a":"周邦彦","t":"浪涛沙・浪淘沙","s":"宋词三百首"},{"id":149,"q":"当时宋玉悲感，向此临水与登山。","a":"柳永","t":"戚氏","s":"宋词三百首"},{"id":150,"q":"天命玄鸟，降而生商，宅殷土芒芒。古帝命武汤，正域彼四方。","a":"佚名","t":"玄鸟","s":"诗经"},{"id":151,"q":"楚塞三湘接，荆门九派通。","a":"王维","t":"汉江临眺","s":"水墨唐诗"},{"id":152,"q":"春雨宜读书，夏雨宜弈棋，秋雨宜检藏，冬雨宜饮酒。","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":153,"q":"花之胜于美人者，生香也。","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":154,"q":"彼泽之陂，有蒲菡萏。有美一人，硕大且俨。寤寐无为，辗转伏枕。","a":"佚名","t":"泽陂","s":"诗经"},{"id":155,"q":"非求益者也，欲速成者也。","a":"孔子","t":"宪问篇","s":"论语"},{"id":156,"q":"但茫茫暮霭，目断武陵溪。","a":"韩元吉","t":"六州歌头","s":"宋词三百首"},{"id":157,"q":"白发三千丈，缘愁似个长。","a":"李白","t":"秋浦歌","s":"水墨唐诗"},{"id":158,"q":"知其说者之于天下也，其如示诸斯乎！","a":"孔子","t":"八佾篇","s":"论语"},{"id":159,"q":"朋友之馈，虽车马，非祭肉，不拜。","a":"孔子","t":"乡党篇","s":"论语"},{"id":160,"q":"万方有罪，罪在朕躬。","a":"孔子","t":"尧曰篇","s":"论语"},{"id":161,"q":"薄宦梗犹泛，故园芜已平。","a":"李商隐","t":"蝉","s":"水墨唐诗"},{"id":162,"q":"攻其恶，无攻人之恶，非修慝与？","a":"孔子","t":"颜渊篇","s":"论语"},{"id":163,"q":"十岁为神童，二十、三十为才子，四十、五十为名臣，六十为神仙，可谓全人矣。","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":164,"q":"如何是与众乐乐，曰马吊。","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":165,"q":"苦战应憔悴，寒衣不要宽。","a":"白居易","t":"闺怨词","s":"水墨唐诗"},{"id":166,"q":"妻、子颇足累人，羡和靖梅妻鹤子；","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":167,"q":"境有言之极雅而实难堪者，贫病也；","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":168,"q":"吹尽繁红，占春长久，不如垂柳。","a":"晁补之","t":"水龙吟","s":"宋词三百首"},{"id":169,"q":"八年十二月，五日雪纷纷。","a":"白居易","t":"村民苦寒（节选）","s":"水墨唐诗"},{"id":170,"q":"万里悲秋常作客，百年多病独登台。","a":"杜甫","t":"登高","s":"水墨唐诗"},{"id":171,"q":"我未见力不足者。","a":"孔子","t":"里仁篇","s":"论语"},{"id":172,"q":"宝马雕车香满路。","a":"辛弃疾","t":"青玉案","s":"宋词三百首"},{"id":173,"q":"慢令致期谓之贼；","a":"孔子","t":"尧曰篇","s":"论语"},{"id":174,"q":"情必近于痴而始真，才必兼乎趣而始化。","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":175,"q":"不才明主弃，多病故人疏。","a":"孟浩然","t":"岁暮归南山","s":"水墨唐诗"},{"id":176,"q":"丰水东注，维禹之绩。四方攸同，皇王维辟。皇王烝哉！","a":"佚名","t":"文王有声","s":"诗经"},{"id":177,"q":"管氏亦有反坫，管氏而知礼，孰不知礼？","a":"孔子","t":"八佾篇","s":"论语"},{"id":178,"q":"卖炭得钱何所营，身上衣裳口中食。","a":"白居易","t":"卖炭翁","s":"水墨唐诗"},{"id":179,"q":"题之熟者，参之以新奇之想；","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":180,"q":"黄鸟黄鸟，无集于穀，无啄我粟。此邦之人，不我肯穀。言旋言归，复我邦族。","a":"佚名","t":"黄鸟","s":"诗经"},{"id":181,"q":"执圭，鞠躬如也，如不胜。","a":"孔子","t":"乡党篇","s":"论语"},{"id":182,"q":"朕躬有罪，无以万方；","a":"孔子","t":"尧曰篇","s":"论语"},{"id":183,"q":"此皆所谓密友也。","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":184,"q":"丁香露泣残枝，算未比、愁肠寸结。","a":"蔡伸","t":"柳梢青","s":"宋词三百首"},{"id":185,"q":"终风且暴，顾我则笑，谑浪笑敖，中心是悼。","a":"佚名","t":"终风","s":"诗经"},{"id":186,"q":"今来县宰加朱绂，便是生灵血染成。","a":"杜荀鹤","t":"再经胡城县","s":"水墨唐诗"},{"id":187,"q":"然入声之为字也少，不得谓凡字皆有四声也。","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":188,"q":"迩之事父，远之事君，多识于鸟兽草木之名。","a":"孔子","t":"阳货篇","s":"论语"},{"id":189,"q":"君子无众寡，无小大，无敢慢，斯不亦泰而不骄乎？","a":"孔子","t":"尧曰篇","s":"论语"},{"id":190,"q":"凤凰于飞，翙翙其羽，亦集爰止。蔼蔼王多吉士，维君子使，媚于天子。","a":"佚名","t":"卷阿","s":"诗经"},{"id":191,"q":"遥计百年之后，必有其人，惜乎不及见耳！","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":192,"q":"文名可以当科第，俭德可以当货财，清闲可以当寿考。","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":193,"q":"勃如战色，足蹜蹜如有循。","a":"孔子","t":"乡党篇","s":"论语"},{"id":194,"q":"空阶有鸟迹，犹似造书时。","a":"岑参","t":"题三会寺仓颉造字台","s":"水墨唐诗"},{"id":195,"q":"唯留一湖水，与汝救凶年。","a":"白居易","t":"别州民","s":"水墨唐诗"},{"id":196,"q":"近乡情更怯，不敢问来人。","a":"李频","t":"渡汉江","s":"水墨唐诗"},{"id":197,"q":"毖彼泉水，亦流于淇。有怀于卫，靡日不思。娈彼诸姬，聊与之谋。","a":"佚名","t":"泉水","s":"诗经"},{"id":198,"q":"涉世，须参以晋代之风流。","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":199,"q":"一路经行处，莓苔见屐痕。","a":"刘长卿","t":"寻南溪常道士","s":"水墨唐诗"},{"id":200,"q":"风烟雨雪阴晴晚，更何须，春风千树。","a":"彭元逊","t":"解佩环・疏影","s":"宋词三百首"},{"id":201,"q":"邦无道，富且贵焉，耻也。","a":"孔子","t":"泰伯篇","s":"论语"},{"id":202,"q":"灞原风雨定，晚见雁行频。","a":"马戴","t":"灞上秋居","s":"水墨唐诗"},{"id":203,"q":"残寒销尽，疏雨过、清明後。","a":"李之仪","t":"谢池春","s":"宋词三百首"},{"id":204,"q":"滮池北流，浸彼稻田。啸歌伤怀，念彼硕人。","a":"佚名","t":"白华","s":"诗经"},{"id":205,"q":"宜有词仙，拥素云黄鹤，与君游戏。","a":"姜夔","t":"翠楼吟","s":"宋词三百首"},{"id":206,"q":"维鹊有巢，维鸠方之。之子于归，百两将之。","a":"佚名","t":"鹊巢","s":"诗经"},{"id":207,"q":"空樽夜泣，青山不语，残月当门。","a":"黄孝迈","t":"湘春夜月","s":"宋词三百首"},{"id":208,"q":"民亦劳止，汔可小愒。惠此中国，俾民忧泄。无纵诡随，以谨丑厉。","a":"佚名","t":"民劳","s":"诗经"},{"id":209,"q":"诸葛武侯，以出师讲学者也。","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":210,"q":"若读书与游山，虽或相倍蓰，恐亦不足以偿所愿也。","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":211,"q":"漠漠帆来重，冥冥鸟去迟。","a":"韦应物","t":"赋得暮雨送李曹","s":"水墨唐诗"},{"id":212,"q":"商女不知亡国恨，隔江犹唱后庭花。","a":"杜牧","t":"泊秦淮","s":"水墨唐诗"},{"id":213,"q":"女曰鸡鸣，士曰昧旦。子兴视夜，明星有烂。将翱将翔，弋凫与雁。","a":"佚名","t":"女曰鸡鸣","s":"诗经"},{"id":214,"q":"月出皎兮。佼人僚兮。舒窈纠兮。劳心悄兮。","a":"佚名","t":"月出","s":"诗经"},{"id":215,"q":"但数点红英，犹识西园凄婉。","a":"王沂孙","t":"长亭怨・长亭怨慢","s":"宋词三百首"},{"id":216,"q":"黄鹤一去不复返，白云千载空悠悠。","a":"崔颢","t":"黄鹤楼","s":"水墨唐诗"},{"id":217,"q":"还作江南会，翻疑梦里逢。","a":"戴叔伦","t":"江乡故人偶集客舍","s":"水墨唐诗"},{"id":218,"q":"昊天曰明，及尔出王。昊天曰旦，及尔游衍。","a":"佚名","t":"板","s":"诗经"},{"id":219,"q":"上马人扶残醉，晓风吹未醒。","a":"周邦彦","t":"绮寮怨","s":"宋词三百首"},{"id":220,"q":"知之为知之，不知为不知，是知也。","a":"孔子","t":"为政篇","s":"论语"},{"id":221,"q":"月中山河之影，天文中地理也；","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":222,"q":"夫闻也者，色取仁而行违，居之不疑。","a":"孔子","t":"颜渊篇","s":"论语"},{"id":223,"q":"近泪无干土，低空有断云。","a":"杜甫","t":"别房太尉墓","s":"水墨唐诗"},{"id":224,"q":"未谙姑食性，先遣小姑尝。","a":"王建","t":"新嫁娘","s":"水墨唐诗"},{"id":225,"q":"葛屦五两，冠緌双止。鲁道有荡，齐子庸止。既曰庸止，曷又从止？","a":"佚名","t":"南山","s":"诗经"},{"id":226,"q":"我车既攻，我马既同。四牡庞庞，驾言徂东。","a":"佚名","t":"车攻","s":"诗经"},{"id":227,"q":"羔裘逍遥，狐裘以朝。岂不尔思？劳心忉忉。","a":"佚名","t":"羔裘","s":"诗经"},{"id":228,"q":"猗嗟娈兮，清扬婉兮。舞则选兮，射则贯兮，四矢反兮，以御乱兮。","a":"佚名","t":"猗嗟","s":"诗经"},{"id":229,"q":"明月如霜，好风如水，清景无限。","a":"苏轼","t":"永遇乐","s":"宋词三百首"},{"id":230,"q":"坠粉飘香，日日唤愁生。","a":"卢祖皋","t":"江城子","s":"宋词三百首"},{"id":231,"q":"朋酒斯飨，曰杀羔羊，跻彼公堂。称彼兕觥：万寿无疆！","a":"佚名","t":"七月","s":"诗经"},{"id":232,"q":"念腰间箭，匣中剑，空埃蠹，竟何成。","a":"张孝祥","t":"六州歌头","s":"宋词三百首"},{"id":233,"q":"至于犬马皆能有养；","a":"孔子","t":"为政篇","s":"论语"},{"id":234,"q":"大车槛槛，毳衣如菼。岂不尔思？畏子不敢。","a":"佚名","t":"大车","s":"诗经"},{"id":235,"q":"如今但暮雨，蜂愁蝶恨，小窗闲对芭蕉展。","a":"吕渭老","t":"薄幸","s":"宋词三百首"},{"id":236,"q":"牛困人饥日已高，市南门外泥中歇。","a":"白居易","t":"卖炭翁","s":"水墨唐诗"},{"id":237,"q":"永怀愁不寐，松月夜窗虚。","a":"孟浩然","t":"岁暮归南山","s":"水墨唐诗"},{"id":238,"q":"卷尽愁云，素娥临夜新梳洗。","a":"吴文英","t":"点绛唇","s":"宋词三百首"},{"id":239,"q":"宾既醉止，载号载呶。乱我笾豆，屡舞僛僛。是曰既醉，不知其邮。","a":"佚名","t":"宾之初筵","s":"诗经"},{"id":240,"q":"并头联句，交颈论文，宫中应制，历使属国，皆极人间乐事。","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":241,"q":"柴也愚，参也鲁，师也辟，由也喭。","a":"孔子","t":"先进篇","s":"论语"},{"id":242,"q":"齐景公有马千驷，死之日，民无德而称焉；","a":"孔子","t":"季氏篇","s":"论语"},{"id":243,"q":"蟠桃、老桂之属，近于仙者也；","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":244,"q":"清高固然可嘉，莫流于不识时务。","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":245,"q":"染柳烟浓，吹梅笛怨，春意知几许。","a":"李清照","t":"永遇乐","s":"宋词三百首"},{"id":246,"q":"芳草王孙知何处，惟有杨花糁径。","a":"潘汾","t":"贺新郎","s":"宋词三百首"},{"id":247,"q":"子路从而后，遇丈人，以杖荷蓧。","a":"孔子","t":"微子篇","s":"论语"},{"id":248,"q":"死丧之威，兄弟孔怀。原隰裒矣，兄弟求矣。","a":"佚名","t":"棠棣","s":"诗经"},{"id":249,"q":"细草微风岸，危樯独夜舟。","a":"杜甫","t":"旅夜书怀","s":"水墨唐诗"},{"id":250,"q":"凫鹥在沙，公尸来燕来宜。尔酒既多，尔肴既嘉。公尸燕饮，福禄来为。","a":"佚名","t":"凫鹥","s":"诗经"},{"id":251,"q":"藏书不难，能看为难；","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":252,"q":"不独诵其诗、读其书是尚友古人，即观其字画，亦是尚友古人处。","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":253,"q":"凡物皆以形用，其以神用者，则镜也、符印也、日晷也、指南针也。","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":254,"q":"凤凰台上凤凰游，凤去台空江自流。","a":"李白","t":"登金陵凤凰台","s":"水墨唐诗"},{"id":255,"q":"爱之欲其生，恶之欲其死；","a":"孔子","t":"颜渊篇","s":"论语"},{"id":256,"q":"文王既勤止，我应受之。敷时绎思，我徂维求定。时周之命，于绎思。","a":"佚名","t":"赉","s":"诗经"},{"id":257,"q":"向长安，对秋灯，几人老。","a":"吴文英","t":"夜游宫","s":"宋词三百首"},{"id":258,"q":"空山不见人，但闻人语响。","a":"王维","t":"鹿柴","s":"水墨唐诗"},{"id":259,"q":"然止当与割股、庐墓者作一例看。","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":260,"q":"一声何满子，双泪落君前。","a":"张祜","t":"何满子","s":"水墨唐诗"},{"id":261,"q":"天生烝民，其命匪谌。靡不有初，鲜克有终。","a":"佚名","t":"荡","s":"诗经"},{"id":262,"q":"讫、乞等，四支之入声也。","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":263,"q":"十里扬州，三生杜牧，前事休说。","a":"姜夔","t":"琵琶仙・自度曲","s":"宋词三百首"},{"id":264,"q":"人而不仁，疾之已甚，乱也。","a":"孔子","t":"泰伯篇","s":"论语"},{"id":265,"q":"昔年多病厌芳尊，今日芳尊惟恐浅。","a":"钱惟演","t":"木兰花・玉楼春","s":"宋词三百首"},{"id":266,"q":"又说是、蛟馋龙怒。","a":"刘克庄","t":"贺新郎","s":"宋词三百首"},{"id":267,"q":"贤者识其大者，不贤者识其小者，莫不有文武之道焉，夫子焉不学？","a":"孔子","t":"子张篇","s":"论语"},{"id":268,"q":"神之吊矣，诒尔多福。民之质矣，日用饮食。群黎百姓，遍为尔德。","a":"佚名","t":"天保","s":"诗经"},{"id":269,"q":"墙有茨，不可束也。中冓之言，不可读也。所可读也，言之辱也。","a":"佚名","t":"墙有茨","s":"诗经"},{"id":270,"q":"夫子之言性与天道，不可得而闻也。","a":"孔子","t":"公冶长篇","s":"论语"},{"id":271,"q":"帘影灯昏，心寄胡琴语。","a":"贺铸","t":"蝶恋花","s":"宋词三百首"},{"id":272,"q":"陟彼高冈，我马玄黄。我姑酌彼兕觥，维以不永伤。","a":"佚名","t":"卷耳","s":"诗经"},{"id":273,"q":"昔者吾友尝从事于斯矣。","a":"孔子","t":"泰伯篇","s":"论语"},{"id":274,"q":"荷笠带斜阳，青山独归远。","a":"刘长卿","t":"送灵澈","s":"水墨唐诗"},{"id":275,"q":"成王之孚，下土之式。永言孝思，孝思维则。","a":"佚名","t":"下武","s":"诗经"},{"id":276,"q":"忽如一夜春风来，千树万树梨花开。","a":"岑参","t":"白雪歌送武判官归京","s":"水墨唐诗"},{"id":277,"q":"荆之闻分而枯，闻不分而活，其兄弟也；","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":278,"q":"发前人未发之论，方是奇书；","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":279,"q":"田家衣食无厚薄，不见县门身即乐。","a":"王建","t":"田家行","s":"水墨唐诗"},{"id":280,"q":"终其永怀，又窘阴雨。其车既载，乃弃尔辅。载输尔载，将伯助予！","a":"佚名","t":"正月","s":"诗经"},{"id":281,"q":"孺悲欲见孔子，孔子辞以疾。","a":"孔子","t":"阳货篇","s":"论语"},{"id":282,"q":"吴宫花草埋幽径，晋代衣冠成古丘。","a":"李白","t":"登金陵凤凰台","s":"水墨唐诗"},{"id":283,"q":"秋阴时晴渐向暝，变一庭凄冷。","a":"周邦彦","t":"关河令・清商怨","s":"宋词三百首"},{"id":284,"q":"盖均无贫，和无寡，安无倾。","a":"孔子","t":"季氏篇","s":"论语"},{"id":285,"q":"势分三足鼎，业复五铢钱。","a":"刘禹锡","t":"蜀先主庙","s":"水墨唐诗"},{"id":286,"q":"自牧归荑，洵美且异。匪女之为美，美人之贻。","a":"佚名","t":"静女","s":"诗经"},{"id":287,"q":"日暮汉宫传蜡烛，轻烟散入五侯家。","a":"韩竑","t":"寒食","s":"水墨唐诗"},{"id":288,"q":"垂死病中惊坐起，暗风吹雨入寒窗。","a":"元稹","t":"闻乐天授江州司马","s":"水墨唐诗"},{"id":289,"q":"骄人好好，劳人草草。苍天苍天，视彼骄人，矜此劳人。","a":"佚名","t":"巷伯","s":"诗经"},{"id":290,"q":"都缘自有离恨，故画作远山长。","a":"欧阳修","t":"诉衷情","s":"宋词三百首"},{"id":291,"q":"帝乡明日到，犹自梦渔樵。","a":"许浑","t":"秋日赴阙题潼关驿楼","s":"水墨唐诗"},{"id":292,"q":"子罕言利与命与仁。","a":"孔子","t":"子罕篇","s":"论语"},{"id":293,"q":"斗筲之人，何足算也！","a":"孔子","t":"子路篇","s":"论语"},{"id":294,"q":"三爵不识，矧敢多又。","a":"佚名","t":"宾之初筵","s":"诗经"},{"id":295,"q":"狐裘蒙戎，匪车不东。叔兮伯兮，靡所与同。","a":"佚名","t":"旄丘","s":"诗经"},{"id":296,"q":"想夜半承明，留教视草，却遣筹边。","a":"辛弃疾","t":"木兰花慢","s":"宋词三百首"},{"id":297,"q":"不寝听金钥，因风想玉珂。","a":"杜甫","t":"春宿左省","s":"水墨唐诗"},{"id":298,"q":"画船载、清明过却，晴烟冉冉吴宫树。","a":"吴文英","t":"莺啼序","s":"宋词三百首"},{"id":299,"q":"目不能识字，其闷尤过于盲；","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":300,"q":"能会难通之解，方可参最上禅机。","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":301,"q":"有鄙夫问于我，空空如也。","a":"孔子","t":"子罕篇","s":"论语"},{"id":302,"q":"人则女美于男，禽则雄华于雌，兽则牝牡无分者也。","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":303,"q":"东方之月兮，彼姝者子，在我闼兮。在我闼兮，履我发兮。","a":"佚名","t":"东方之日","s":"诗经"},{"id":304,"q":"玉楼天半起笙歌，风送宫嫔笑语和。","a":"顾况","t":"宫词","s":"水墨唐诗"},{"id":305,"q":"渚寒烟淡，棹移人远，缥缈行舟如叶。","a":"姜夔","t":"八归","s":"宋词三百首"},{"id":306,"q":"明朝事与孤烟冷，做满湖、风雨愁人。","a":"吴文英","t":"渡江云三犯・渡江云","s":"宋词三百首"},{"id":307,"q":"恒之穈芑，是任是负。以归肇祀。","a":"佚名","t":"生民","s":"诗经"},{"id":308,"q":"然则如之何而后可？","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":309,"q":"旱既大甚，蕴隆虫虫。不殄禋祀，自郊徂宫。上下奠瘗，靡神不宗。","a":"佚名","t":"云汉","s":"诗经"},{"id":310,"q":"相鼠有皮，人而无仪！人而无仪，不死何为？","a":"佚名","t":"相鼠","s":"诗经"},{"id":311,"q":"何当金络脑，快走踏清秋。","a":"李贺","t":"马诗","s":"水墨唐诗"},{"id":312,"q":"飘飘何所似，天地一沙鸥。","a":"杜甫","t":"旅夜书怀","s":"水墨唐诗"},{"id":313,"q":"秦时明月汉时关，万里长征人未还。","a":"王昌龄","t":"出塞","s":"水墨唐诗"},{"id":314,"q":"东门之杨，其叶牂牂。昏以为期，明星煌煌。","a":"佚名","t":"东门之杨","s":"诗经"},{"id":315,"q":"方茂尔恶，相尔矛矣。既夷既怿，如相酬矣。","a":"佚名","t":"节南山","s":"诗经"},{"id":316,"q":"墓门有梅，有鸮萃止。夫也不良，歌以讯之。讯予不顾，颠倒思予。","a":"佚名","t":"墓门","s":"诗经"},{"id":317,"q":"闻鹅声，如在白门；","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":318,"q":"侍食于君，君祭，先饭。","a":"孔子","t":"乡党篇","s":"论语"},{"id":319,"q":"必也，如黄九烟前辈之所云，人生必三百年而后可乎？","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":320,"q":"蛛为蝶之敌国，驴为马之附庸。","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":321,"q":"好之者不如乐之者。","a":"孔子","t":"雍也篇","s":"论语"},{"id":322,"q":"子疾病，子路使门人为臣。","a":"孔子","t":"子罕篇","s":"论语"},{"id":323,"q":"残灯无焰影幢幢，此夕闻君谪九江。","a":"元稹","t":"闻乐天授江州司马","s":"水墨唐诗"},{"id":324,"q":"如社燕，飘流瀚海，来寄修椽。","a":"周邦彦","t":"满庭芳","s":"宋词三百首"},{"id":325,"q":"多见而识之，知之次也。","a":"孔子","t":"述而篇","s":"论语"},{"id":326,"q":"欲祭疑君在，天涯哭此时。","a":"张籍","t":"没蕃故人","s":"水墨唐诗"},{"id":327,"q":"惟将迟暮供多病，未有涓埃答圣朝。","a":"杜甫","t":"野望","s":"水墨唐诗"},{"id":328,"q":"风悲画角，听单于、三弄落谯门。","a":"孔夷","t":"南浦","s":"宋词三百首"},{"id":329,"q":"曾驰道同载，上林携手，灯夜初过早共约。","a":"张元干","t":"兰陵王","s":"宋词三百首"},{"id":330,"q":"如有用我者，吾其为东周乎！","a":"孔子","t":"阳货篇","s":"论语"},{"id":331,"q":"千里黄云白日曛，北风吹雁雪纷纷。","a":"高适","t":"别董大","s":"水墨唐诗"},{"id":332,"q":"尔舜，天之历数在尔躬，允执其中。","a":"孔子","t":"尧曰篇","s":"论语"},{"id":333,"q":"羔羊之革，素丝五緎。委蛇委蛇，自公退食。","a":"佚名","t":"羔羊","s":"诗经"},{"id":334,"q":"专务交游，其后必致累己。","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":335,"q":"绿杨庭院，暖风帘幕，有个人憔悴。","a":"无名氏","t":"青玉案","s":"宋词三百首"},{"id":336,"q":"洧之外，洵訏且乐。维士与女，伊其相谑，赠之以勺药。","a":"佚名","t":"溱洧","s":"诗经"},{"id":337,"q":"隰桑有阿，其叶有沃。既见君子，云何不乐。","a":"佚名","t":"隰桑","s":"诗经"},{"id":338,"q":"楚楚者茨，言抽其棘，自昔何为？我蓺黍稷。我黍与与，我稷翼翼。","a":"佚名","t":"楚茨","s":"诗经"},{"id":339,"q":"寻常相见了，犹道不如初。","a":"晁冲之","t":"临江仙","s":"宋词三百首"},{"id":340,"q":"天极不难做，只须生仁人君子有才德者二三十人足矣。","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":341,"q":"溥彼韩城，燕师所完。以先祖受命，因时百蛮。","a":"佚名","t":"韩奕","s":"诗经"},{"id":342,"q":"而色之浅深浓淡，又须与花相反。","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":343,"q":"早已有、游人观渡。","a":"刘克庄","t":"贺新郎","s":"宋词三百首"},{"id":344,"q":"渐黄昏，清角吹寒，都在空城。","a":"姜夔","t":"扬州慢","s":"宋词三百首"},{"id":345,"q":"予谓匪独禽兽也，即草木亦复有之。","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":346,"q":"葛生蒙棘，蔹蔓于域。予美亡此，谁与？独息？","a":"佚名","t":"葛生","s":"诗经"},{"id":347,"q":"正是江南好风景，落花时节又逢君。","a":"杜甫","t":"江南逢李龟年","s":"水墨唐诗"},{"id":348,"q":"延名师训子弟，入名山习举业，丐名士代捉刀，三者都无是处。","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":349,"q":"吾恐季孙之忧不在颛臾，而在萧墙之内也。","a":"孔子","t":"季氏篇","s":"论语"},{"id":350,"q":"能近取譬，可谓仁之方也已。","a":"孔子","t":"雍也篇","s":"论语"},{"id":351,"q":"长安故人问我，道寻常、泥酒只依然。","a":"辛弃疾","t":"木兰花慢","s":"宋词三百首"},{"id":352,"q":"谁爱风流高格调，共怜时世俭梳妆。","a":"秦韬玉","t":"贫女","s":"水墨唐诗"},{"id":353,"q":"今夜偏知春气暖，虫声新透绿窗纱。","a":"刘方平","t":"月夜","s":"水墨唐诗"},{"id":354,"q":"管乐有才真不忝，关张无命欲何如。","a":"李商隐","t":"筹笔驿","s":"水墨唐诗"},{"id":355,"q":"靡圣管管。不实于亶。犹之未远，是用大谏。","a":"佚名","t":"板","s":"诗经"},{"id":356,"q":"总为浮云能蔽日，长安不见使人愁。","a":"李白","t":"登金陵凤凰台","s":"水墨唐诗"},{"id":357,"q":"立则见其参于前也；","a":"孔子","t":"卫灵公篇","s":"论语"},{"id":358,"q":"好勇不好学，其蔽也乱；","a":"孔子","t":"阳货篇","s":"论语"},{"id":359,"q":"中唐有甓，邛有旨鷊。谁侜予美？心焉惕惕。","a":"佚名","t":"防有鹊巢","s":"诗经"},{"id":360,"q":"由戒得定，由定得慧，勉强渐近自然；","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":361,"q":"凡花色之娇媚者，多不甚香；","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":362,"q":"筑城须努力，城高遮得贼。","a":"元稹","t":"古筑城曲（二首）","s":"水墨唐诗"},{"id":363,"q":"又或为士大夫所有，果能不问主人，任我之登陟凭吊，而莫之禁乎？","a":"张潮","t":"幽梦影","s":"幽梦影"},{"id":364,"q":"花近高楼伤客心，万方多难此登临。","a":"杜甫","t":"登楼","s":"水墨唐诗"},{"id":365,"q":"笃公刘，逝彼百泉。瞻彼溥原，乃陟南冈。乃觏于京，京师之野。","a":"佚名","t":"公刘","s":"诗经"}]